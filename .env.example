APP_NAME=Einkaufsliste
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Die App hat keine Nutzer und keine Hintergrundarbeit: Die Session lebt nur
# im Request, der Cache liegt als Datei neben der App, Jobs laufen sofort.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# NativePHP
# Leer lassen, um die Defaults aus config/nativephp.php zu benutzen
# (app_id de.ben182.einkaufsliste).
NATIVEPHP_APP_ID=
NATIVEPHP_APP_VERSION=
NATIVEPHP_APP_VERSION_CODE=

# Android-Signierung (nur auf dem Build-Rechner, nie im Bundle).
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# Mealie
MEALIE_URL=https://mealie.example.test
MEALIE_SHOPPING_LIST_ID=00000000-0000-4000-8000-000000000000
