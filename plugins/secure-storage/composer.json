{
    "name": "ben182/secure-storage",
    "description": "Keychain / Keystore backed secure storage for NativePHP Mobile",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ben182\\SecureStorage\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ben182\\SecureStorage\\SecureStorageServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
