{
    "name": "ben182/appearance",
    "description": "Pins a NativePHP Mobile app to light or dark, independently of the system setting",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Ben182\\Appearance\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ben182\\Appearance\\AppearanceServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
